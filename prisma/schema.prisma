// YAAS — Prisma schema
// Prisma 7 + PostgreSQL (Supabase). The datasource URL lives in prisma.config.ts,
// not here: Prisma 7 reads connection config from the config file / driver adapter.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum MemberStatus {
  PENDING
  ACTIVE
  DEACTIVATED
}

enum JoinMethod {
  FOUNDED
  INVITE_CODE
  REQUEST
  DOMAIN
}

enum TeamRole {
  LEAD
  MEMBER
}

enum CalendarType {
  PERSONAL
  TEAM
  ORGANIZATION
  EXTERNAL
}

enum CalendarAccessLevel {
  VIEW
  COMMENT
  EDIT
  FULL_ACCESS
}

enum EventVisibility {
  DEFAULT
  PUBLIC
  PRIVATE
  CONFIDENTIAL
}

enum AttendeeStatus {
  NEEDS_ACTION
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RiskLevel {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskSource {
  MANUAL
  WHATSAPP
  SLACK
  AI_PARSED
  RECURRING
  CALENDAR
  EMAIL
  IMPORT
  API
}

enum TaskAssignmentRole {
  OWNER
  COLLABORATOR
  REVIEWER
}

enum DependencyType {
  BLOCKS
  RELATES_TO
}

enum ReminderScheduleType {
  MORNING_DIGEST
  EVENING_REVIEW
  WEEKLY_REVIEW
  DEADLINE_SWEEP
  CUSTOM
}

enum DeliveryChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SLACK
  PUSH
}

enum DeliveryStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  TASK_COMPLETED
  TASK_COMMENT
  TASK_MENTION
  TASK_BLOCKED
  EVENT_INVITE
  EVENT_REMINDER
  EVENT_UPDATED
  MEMBER_JOIN_REQUEST
  MEMBER_APPROVED
  AI_SUGGESTION
  DIGEST
  SYSTEM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum AIParseStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  APPLIED
  REJECTED
}

enum LLMRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

enum AISuggestionType {
  TASK_PRIORITY
  TASK_BREAKDOWN
  SCHEDULE_SLOT
  ROADBLOCK_RESOLUTION
  WORKLOAD_REBALANCE
  DEADLINE_ADJUSTMENT
}

enum AISuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
  EXPIRED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  INVITE
  APPROVE
  REJECT
  PERMISSION_CHANGE
  EXPORT
}

// ---------------------------------------------------------------------------
// Auth.js
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]
  profile  Profile?
  settings UserSettings?

  ownedOrganizations  Organization[]       @relation("OrganizationOwner")
  createdInvites      OrganizationInvite[] @relation("OrganizationInviteCreator")
  organizationMembers OrganizationMember[] @relation("OrganizationMemberUser")
  approvedMemberships OrganizationMember[] @relation("OrganizationMemberApprover")
  teamMemberships     TeamMember[]

  calendars              Calendar[]
  createdEvents          CalendarEvent[] @relation("CalendarEventCreator")
  eventAttendances       EventAttendee[]
  calendarSharesReceived CalendarShare[] @relation("CalendarShareUser")
  calendarSharesGranted  CalendarShare[] @relation("CalendarShareGrantedBy")

  createdTasks        Task[]                @relation("TaskCreator")
  taskAssignments     TaskAssignment[]      @relation("TaskAssignmentUser")
  taskAssignmentsMade TaskAssignment[]      @relation("TaskAssignmentAssigner")
  taskComments        TaskComment[]
  attachments         Attachment[]
  taskLinksAdded      TaskLink[]
  statusChanges       TaskStatusHistory[]
  priorityChanges     TaskPriorityHistory[]
  createdLabels       Label[]

  recurringTasks    RecurringTask[]    @relation("RecurringTaskOwner")
  recurringAssigned RecurringTask[]    @relation("RecurringTaskAssignee")
  reminders         Reminder[]
  reminderSchedules ReminderSchedule[]

  notifications    Notification[]
  whatsappMessages WhatsAppMessage[]

  aiParsedTasks    AIParsedTask[]
  llmConversations LLMConversation[]
  aiSuggestions    AISuggestion[]

  diaryEntries DiaryEntry[]

  productivitySnapshots ProductivitySnapshot[]
  activityLogs          ActivityLog[]
  auditLogs             AuditLog[]

  @@index([email])
  @@index([createdAt])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String?
  id_token          String? @map("id_token")
  session_state     String? @map("session_state")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Profile & settings
// ---------------------------------------------------------------------------

model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique @map("user_id")
  displayName String? @map("display_name")
  avatarUrl   String? @map("avatar_url")
  bio         String?
  jobTitle    String? @map("job_title")

  whatsappNumber     String?   @unique @map("whatsapp_number")
  whatsappVerified   Boolean   @default(false) @map("whatsapp_verified")
  whatsappVerifiedAt DateTime? @map("whatsapp_verified_at")
  whatsappOptIn      Boolean   @default(false) @map("whatsapp_opt_in")

  timezone          String @default("UTC")
  locale            String @default("en")
  workingHoursStart Int    @default(9) @map("working_hours_start")
  workingHoursEnd   Int    @default(17) @map("working_hours_end")
  workingDays       Int[]  @default([1, 2, 3, 4, 5]) @map("working_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([whatsappNumber])
  @@map("profiles")
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  theme                 String  @default("system")
  uiScale               String  @default("medium") @map("ui_scale")
  emailNotifications    Boolean @default(true) @map("email_notifications")
  whatsappNotifications Boolean @default(false) @map("whatsapp_notifications")
  pushNotifications     Boolean @default(true) @map("push_notifications")
  inAppNotifications    Boolean @default(true) @map("in_app_notifications")

  aiSuggestionsEnabled Boolean @default(true) @map("ai_suggestions_enabled")
  autoPrioritize       Boolean @default(true) @map("auto_prioritize")
  digestEnabled        Boolean @default(true) @map("digest_enabled")

  defaultCalendarId     String? @map("default_calendar_id")
  defaultOrganizationId String? @map("default_organization_id")
  defaultTaskView       String  @default("list") @map("default_task_view")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ---------------------------------------------------------------------------
// Organizations, roles & permissions
// ---------------------------------------------------------------------------

model Organization {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  logoUrl     String? @map("logo_url")
  ownerId     String  @map("owner_id")
  plan        String  @default("free")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  owner User @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members  OrganizationMember[]
  roles    Role[]
  teams    Team[]
  invites  OrganizationInvite[]
  settings OrganizationSettings?

  calendars      Calendar[]
  calendarEvents CalendarEvent[]
  eventAttendees EventAttendee[]
  calendarShares CalendarShare[]

  tasks               Task[]
  taskAssignments     TaskAssignment[]
  taskDependencies    TaskDependency[]
  labels              Label[]
  taskLabels          TaskLabel[]
  taskComments        TaskComment[]
  attachments         Attachment[]
  taskLinks           TaskLink[]
  taskStatusHistory   TaskStatusHistory[]
  taskPriorityHistory TaskPriorityHistory[]

  recurringTasks    RecurringTask[]
  reminders         Reminder[]
  reminderSchedules ReminderSchedule[]

  notifications          Notification[]
  notificationDeliveries NotificationDelivery[]
  whatsappMessages       WhatsAppMessage[]
  webhookEvents          WebhookEvent[]

  aiParsedTasks    AIParsedTask[]
  llmConversations LLMConversation[]
  llmMessages      LLMMessage[]
  aiSuggestions    AISuggestion[]

  diaryEntries DiaryEntry[]

  productivitySnapshots ProductivitySnapshot[]
  activityLogs          ActivityLog[]
  auditLogs             AuditLog[]

  @@index([ownerId])
  @@index([slug])
  @@index([deletedAt])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  roleId         String       @map("role_id")
  status         MemberStatus @default(PENDING)

  title         String?
  joinMethod    JoinMethod @default(REQUEST) @map("join_method")
  inviteId      String?    @map("invite_id")
  invitedAt     DateTime?  @map("invited_at")
  joinedAt      DateTime?  @map("joined_at")
  approvedById  String?    @map("approved_by_id")
  approvedAt    DateTime?  @map("approved_at")
  deactivatedAt DateTime?  @map("deactivated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                @relation("OrganizationMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role         Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  approvedBy   User?               @relation("OrganizationMemberApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  invite       OrganizationInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([roleId])
  @@index([approvedById])
  @@index([inviteId])
  @@index([organizationId, status])
  @@map("organization_members")
}

model Role {
  id             String  @id @default(cuid())
  key            String
  name           String
  description    String?
  isSystem       Boolean @default(false) @map("is_system")
  organizationId String? @map("organization_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization   Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  members        OrganizationMember[]
  invites        OrganizationInvite[]
  defaultForOrgs OrganizationSettings[] @relation("OrganizationSettingsDefaultRole")

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([key])
  @@index([isSystem])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  resource    String
  action      String
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  createdAt DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Invites
// ---------------------------------------------------------------------------

/// A shareable code that lets someone into one workspace. The role is baked in
/// at creation, so handing out a code is the same decision as approving a
/// member — which is why redeeming one joins you ACTIVE rather than PENDING.
///
/// Codes are revoked, never deleted: `organization_members.invite_id` points
/// back here, and an admin asking "who did Priya's code let in?" six months
/// later should still get an answer.
model OrganizationInvite {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  roleId         String @map("role_id")
  createdById    String @map("created_by_id")

  /// Stored uppercase and unpadded (NOVA7K2PXM). The dashes users see are a
  /// display concern — normalise on the way in so "nova-7k2p-xm" also works.
  code String @unique

  /// What this code is for, in the admin's words: "Design contractors".
  label String?

  /// Null means unlimited. Redemption checks useCount < maxUses.
  maxUses  Int? @map("max_uses")
  useCount Int  @default(0) @map("use_count")

  /// Only this address may redeem it, lowercased. Null means anyone with the
  /// code. This is what turns a link into a personal invitation.
  email String?

  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdBy    User                 @relation("OrganizationInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  redemptions  OrganizationMember[]

  @@index([organizationId])
  @@index([roleId])
  @@index([createdById])
  @@index([organizationId, revokedAt])
  @@map("organization_invites")
}

// ---------------------------------------------------------------------------
// Teams & organization settings
// ---------------------------------------------------------------------------

model Team {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  name           String
  slug           String
  description    String?
  color          String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  calendars    Calendar[]
  tasks        Task[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([deletedAt])
  @@map("teams")
}

model TeamMember {
  id             String   @id @default(cuid())
  teamId         String   @map("team_id")
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           TeamRole @default(MEMBER)

  joinedAt  DateTime @default(now()) @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([organizationId])
  @@index([teamId, role])
  @@map("team_members")
}

model OrganizationSettings {
  id             String @id @default(cuid())
  organizationId String @unique @map("organization_id")

  defaultTimezone   String @default("UTC") @map("default_timezone")
  defaultLocale     String @default("en") @map("default_locale")
  weekStartsOn      Int    @default(1) @map("week_starts_on")
  workingDays       Int[]  @default([1, 2, 3, 4, 5]) @map("working_days")
  workingHoursStart Int    @default(9) @map("working_hours_start")
  workingHoursEnd   Int    @default(17) @map("working_hours_end")

  /// Whether someone who knows the workspace handle but has no invite code may
  /// ask to be let in. Off means the only way in is a code.
  allowSelfSignup Boolean  @default(false) @map("allow_self_signup")
  /// Applies to handle requests only. An invite code is itself the approval.
  requireApproval Boolean  @default(true) @map("require_approval")
  allowedDomains  String[] @default([]) @map("allowed_domains")
  defaultRoleId   String?  @map("default_role_id")

  aiEnabled       Boolean @default(true) @map("ai_enabled")
  whatsappEnabled Boolean @default(false) @map("whatsapp_enabled")
  brandColor      String? @map("brand_color")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultRole  Role?        @relation("OrganizationSettingsDefaultRole", fields: [defaultRoleId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([defaultRoleId])
  @@map("organization_settings")
}

// ---------------------------------------------------------------------------
// Calendars & events
// ---------------------------------------------------------------------------

model Calendar {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  ownerId        String       @map("owner_id")
  teamId         String?      @map("team_id")
  name           String
  description    String?
  color          String?
  type           CalendarType @default(PERSONAL)
  timezone       String       @default("UTC")
  isDefault      Boolean      @default(false) @map("is_default")
  isVisible      Boolean      @default(true) @map("is_visible")

  provider   String? // google, microsoft, ics, ...
  externalId String?   @map("external_id")
  syncedAt   DateTime? @map("synced_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  team         Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  events       CalendarEvent[]
  shares       CalendarShare[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([teamId])
  @@index([organizationId, type])
  @@index([provider, externalId])
  @@index([deletedAt])
  @@map("calendars")
}

model CalendarEvent {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  calendarId     String  @map("calendar_id")
  createdById    String  @map("created_by_id")
  title          String
  description    String?
  location       String?
  meetingUrl     String? @map("meeting_url")

  startAt  DateTime @map("start_at")
  endAt    DateTime @map("end_at")
  timezone String   @default("UTC")
  allDay   Boolean  @default(false) @map("all_day")

  rrule                 String?
  recurrenceParentId    String?    @map("recurrence_parent_id")
  recurrenceExdates     DateTime[] @default([]) @map("recurrence_exdates")
  originalStartAt       DateTime?  @map("original_start_at")
  isRecurrenceException Boolean    @default(false) @map("is_recurrence_exception")

  visibility EventVisibility @default(DEFAULT)
  status     String          @default("CONFIRMED")
  busy       Boolean         @default(true)

  taskId String? @map("task_id")

  provider   String?
  externalId String? @map("external_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calendar         Calendar        @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  createdBy        User            @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: Cascade)
  recurrenceParent CalendarEvent?  @relation("EventRecurrence", fields: [recurrenceParentId], references: [id], onDelete: Cascade)
  recurrences      CalendarEvent[] @relation("EventRecurrence")
  task             Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)

  attendees     EventAttendee[]
  reminders     Reminder[]
  notifications Notification[]

  @@index([organizationId])
  @@index([calendarId])
  @@index([createdById])
  @@index([recurrenceParentId])
  @@index([taskId])
  @@index([startAt])
  @@index([calendarId, startAt, endAt])
  @@index([organizationId, startAt])
  @@index([provider, externalId])
  @@index([deletedAt])
  @@map("calendar_events")
}

model EventAttendee {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  eventId        String         @map("event_id")
  userId         String?        @map("user_id")
  email          String?
  name           String?
  status         AttendeeStatus @default(NEEDS_ACTION)
  isOptional     Boolean        @default(false) @map("is_optional")
  isOrganizer    Boolean        @default(false) @map("is_organizer")
  respondedAt    DateTime?      @map("responded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@unique([eventId, email])
  @@index([organizationId])
  @@index([eventId])
  @@index([userId])
  @@index([userId, status])
  @@map("event_attendees")
}

model CalendarShare {
  id             String              @id @default(cuid())
  organizationId String              @map("organization_id")
  calendarId     String              @map("calendar_id")
  userId         String              @map("user_id")
  accessLevel    CalendarAccessLevel @default(VIEW) @map("access_level")
  grantedById    String?             @map("granted_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calendar     Calendar     @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  user         User         @relation("CalendarShareUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy    User?        @relation("CalendarShareGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([calendarId, userId])
  @@index([organizationId])
  @@index([calendarId])
  @@index([userId])
  @@index([grantedById])
  @@map("calendar_shares")
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model Task {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  createdById    String  @map("created_by_id")
  teamId         String? @map("team_id")
  parentTaskId   String? @map("parent_task_id")

  title       String
  description String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)

  priorityScore  Float     @default(0) @map("priority_score")
  priorityPinned Boolean   @default(false) @map("priority_pinned")
  riskLevel      RiskLevel @default(NONE) @map("risk_level")
  roadblock      String?
  roadblockAt    DateTime? @map("roadblock_at")

  position Float @default(0)

  startAt          DateTime? @map("start_at")
  dueAt            DateTime? @map("due_at")
  completedAt      DateTime? @map("completed_at")
  estimatedMinutes Int?      @map("estimated_minutes")
  actualMinutes    Int?      @map("actual_minutes")

  source          TaskSource @default(MANUAL)
  aiParsedTaskId  String?    @map("ai_parsed_task_id")
  recurringTaskId String?    @map("recurring_task_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     User           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  team          Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parentTask    Task?          @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks      Task[]         @relation("TaskSubtasks")
  aiParsedTask  AIParsedTask?  @relation(fields: [aiParsedTaskId], references: [id], onDelete: SetNull)
  recurringTask RecurringTask? @relation(fields: [recurringTaskId], references: [id], onDelete: SetNull)

  assignments     TaskAssignment[]
  dependencies    TaskDependency[]      @relation("TaskDependencyFrom")
  dependents      TaskDependency[]      @relation("TaskDependencyTo")
  labels          TaskLabel[]
  comments        TaskComment[]
  attachments     Attachment[]
  links           TaskLink[]
  statusHistory   TaskStatusHistory[]
  priorityHistory TaskPriorityHistory[]
  events          CalendarEvent[]
  reminders       Reminder[]
  notifications   Notification[]
  aiSuggestions   AISuggestion[]

  @@index([organizationId])
  @@index([createdById])
  @@index([teamId])
  @@index([parentTaskId])
  @@index([aiParsedTaskId])
  @@index([recurringTaskId])
  @@index([organizationId, status])
  @@index([organizationId, dueAt])
  @@index([organizationId, status, priorityScore(sort: Desc)])
  @@index([organizationId, position])
  @@index([dueAt])
  @@index([deletedAt])
  @@map("tasks")
}

model TaskAssignment {
